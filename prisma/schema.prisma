// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  nickname     String   @unique
  createdAt    DateTime @default(now())

  refreshTokens  RefreshToken[]
  runs           Run[]
  save           GameSave?
  battleSessions BattleSession[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// 메타 진행(프론트 LocalStorage save 객체)의 서버 사본 — 유저당 1개.
// 자주 조회·검증하는 값은 컬럼으로, 구조가 변할 수 있는 나머지(job, bestTime,
// seenJobs, stats, stagesCleared, 이후 추가 필드)는 data JSONB로 — docs/save-sync/spec.md FR-1.
model GameSave {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  metaLevel Int      @default(1)
  metaXp    Int      @default(0)
  gold      Int      @default(0)
  data      Json     @default("{}")
  version   Int      @default(0) // 동기화 충돌 감지용 낙관적 잠금 (FR-3/FR-4)
  updatedAt DateTime @updatedAt // FR-7 경과 시간 기반 검증의 기준 시각
}

// 판 하나의 결과 기록 (리더보드의 원천 데이터). 데일리 챌린지(challengeId 등)는
// 이번 범위(Phase 3) 밖이라 포함하지 않음 — docs/landing-auth-leaderboard/plan.md 참고.
model Run {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  job          String // 플레이한 직업 id (src/data/jobs.js와 수동 동기화 대상)
  survivalTime Int // 초 단위
  kills        Int
  level        Int // 세션 레벨
  goldEarned   Int
  metaLevel    Int? // 제출 시점의 계정 메타 레벨 스냅샷 — 과거 Run은 NULL(리더보드 집계 시 0 취급)
  createdAt    DateTime @default(now())

  // battle-session-validation: 대조검증 결과. 기존 행은 마이그레이션 시 true로 채워져
  // 기능 도입 이전 기록이 소급 제외되지 않는다(그랜드파더링, plan.md 아키텍처 결정).
  leaderboardEligible Boolean        @default(true)
  sessionId           String?
  session             BattleSession? @relation(fields: [sessionId], references: [id])

  @@index([survivalTime(sort: Desc)]) // 전체 리더보드용
  @@index([userId, createdAt]) // 직전 제출 조회용
}

// 판 하나에 대응하는 전투 세션 — docs/battle-session-validation/spec.md FR-1.
// status: "active"(진행 중) | "finalized"(제출 대조 완료). 미종료 방치 세션은 그대로 둔다(FR-11).
model BattleSession {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  status      String    @default("active")
  startedAt   DateTime  @default(now())
  finalizedAt DateTime?

  events BattleEvent[]
  runs   Run[]

  @@index([userId])
}

// 세션에 속한 개별 이벤트 로그(집계 컬럼 대신 원본 이력 보존 — plan.md 사용자 결정).
// type: "kills"(payload: killsDelta/goldDelta) | "level-up"(level) | "stage-clear"(stageId)
model BattleEvent {
  id        String        @id @default(uuid())
  sessionId String
  session   BattleSession @relation(fields: [sessionId], references: [id])
  type      String
  payload   Json
  createdAt DateTime      @default(now())

  @@index([sessionId])
}
